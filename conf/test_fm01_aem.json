        {"name": "Morning Peak", "start": "07:00", "end": "10:00", "flexibility_mw": 0.012, "bid_price": 8.0, "activation_cost": 2.5},
        {"name": "Midday", "start": "10:00", "end": "17:00", "flexibility_mw": 0.006, "bid_price": 6.0, "activation_cost": 2.5},
        {"name": "Evening Peak", "start": "17:00", "end": "20:00", "flexibility_mw": 0.010, "bid_price": 9.5, "activation_cost": 2.5, "ev_flexibility_mw": 0.0008, "ev_bid_price": 10.0, "ev_activation_cost": 4.5},
        {"name": "Off-peak", "start": "20:00", "end": "07:00", "flexibility_mw": 0.005, "bid_price": 5.5, "activation_cost": 2.5}
      ]
