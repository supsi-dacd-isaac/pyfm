        {"name": "Late Morning", "start": "09:00", "end": "12:00", "flexibility_mw": 0.010, "bid_price": 7.5, "activation_cost": 2.5},
        {"name": "Afternoon/Evening", "start": "12:00", "end": "20:00", "flexibility_mw": 0.006, "bid_price": 6.0, "activation_cost": 2.5},
        {"name": "Night", "start": "20:00", "end": "06:30", "flexibility_mw": 0.004, "bid_price": 5.0, "activation_cost": 2.5}
      ]
    },
    "strategy_4": {
      "name": "Hybrid (S3+S1)",
      "description": "Morning peak aggressive (S3) + full day HP coverage (S1) - RECOMMENDED",
      "asset_types": ["heat_pump"],
      "time_slots": [
        {"name": "Morning Peak (Aggressive)", "start": "06:30", "end": "09:00", "flexibility_mw": 0.020, "bid_price": 9.0, "activation_cost": 2.5},
        {"name": "Late Morning", "start": "09:00", "end": "12:00", "flexibility_mw": 0.012, "bid_price": 8.5, "activation_cost": 2.5},
        {"name": "Afternoon", "start": "12:00", "end": "16:00", "flexibility_mw": 0.008, "bid_price": 7.0, "activation_cost": 2.5},
        {"name": "Evening Peak", "start": "16:00", "end": "19:00", "flexibility_mw": 0.010, "bid_price": 9.5, "activation_cost": 2.5},
        {"name": "Off-peak", "start": "19:00", "end": "06:30", "flexibility_mw": 0.006, "bid_price": 6.0, "activation_cost": 2.5}
      ]
    },
    "strategy_5": {
      "name": "Hybrid2 (S3+S2)",
      "description": "Morning peak aggressive (S3) + evening EV focus (S2)",
      "asset_types": ["heat_pump", "ev_charger"],
      "time_slots": [
        {"name": "Morning Peak (Aggressive)", "start": "06:30", "end": "09:00", "flexibility_mw": 0.020, "bid_price": 9.0, "activation_cost": 2.5},
        {"name": "Late Morning", "start": "09:00", "end": "12:00", "flexibility_mw": 0.010, "bid_price": 7.5, "activation_cost": 2.5},
