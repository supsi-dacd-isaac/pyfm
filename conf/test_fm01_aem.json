  "bidding_strategies": {
    "strategy_1": {
      "name": "HP Only",
      "description": "Heat pumps only, conservative full-day coverage, no EV chargers",
      "asset_types": ["heat_pump"],
      "time_slots": [
        {"name": "Morning Peak", "start": "06:30", "end": "09:00", "flexibility_mw": 0.015, "bid_price": 9.0, "activation_cost": 2.5},
        {"name": "Late Morning", "start": "09:00", "end": "12:00", "flexibility_mw": 0.012, "bid_price": 8.5, "activation_cost": 2.5},
        {"name": "Afternoon", "start": "12:00", "end": "16:00", "flexibility_mw": 0.008, "bid_price": 7.0, "activation_cost": 2.5},
        {"name": "Evening Peak", "start": "16:00", "end": "19:00", "flexibility_mw": 0.010, "bid_price": 9.5, "activation_cost": 2.5},
        {"name": "Off-peak", "start": "19:00", "end": "06:30", "flexibility_mw": 0.006, "bid_price": 6.0, "activation_cost": 2.5}
      ]
